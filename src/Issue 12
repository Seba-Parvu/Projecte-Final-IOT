#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>

#define LM35 34
#define LIGHT 35
#define LED 27
#define STRIP 14
#define SERVO_PIN 25
#define BUTTON 17

const char* ssid = "ProjectesSMX";
const char* password = "SI123456";

WebServer server(80);
Servo servo;

float tempC = 0;
int lightValue = 0;

bool autoMode = true;

int angle = 0;
int stepDir = 3;

unsigned long lastButtonPress = 0;

void handleRoot() {

  // 📌 ESTATS
  bool tempAlert = tempC > 13.5;
  bool lightAlert = lightValue < 1500;

  bool servoActive;
 
  if (autoMode) {
    servoActive = (tempC > 13.5 && lightValue < 1500);
  } else {
    servoActive = (tempC > 13.5);
  }

  String modeText = autoMode ? "AUTO" : "MANUAL";

  String tempColor = tempAlert ? "red" : "green";
  String lightColor = lightAlert ? "red" : "green";

  String servoStatus = servoActive ? "ACTIU" : "PARAT";
  String ledStatus = lightAlert ? "ENCES" : "APAGATS";

  String servoColor = servoActive ? "green" : "gray";

  String page = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta http-equiv="refresh" content="2">

<title>Escola Intel·ligent</title>

<style>

body{
  font-family: Arial;
  background:#f2f2f2;
  text-align:center;
  margin-top:40px;
}

