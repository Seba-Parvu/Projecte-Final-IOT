  width:350px;
  margin:auto;
  background:white;
  padding:25px;
  border-radius:15px;
  box-shadow:0px 0px 10px gray;
}

h1{
  color:#222;
}

h2{
  color:black;
  font-size:22px;
}

.card{
  margin:15px 0;
  padding:12px;
  border-radius:10px;
  background:#eeeeee;
  font-size:20px;
}

.status{
  font-weight:bold;
}

</style>
</head>

<body>

<div class="container">

<h1>Escola Intel·ligent</h1>

<h2>Dades Ambientals</h2>
)rawliteral";

  page += "<div class='card'>🌡️ Temperatura: <span style='color:" + tempColor + "'>" + String(tempC) + " ºC</span></div>";

  page += "<div class='card'>💡 Llum: <span style='color:" + lightColor + "'>" + String(lightValue) + "</span></div>";

  page += "<div class='card'>🔘 Mode: <span class='status'>" + modeText + "</span></div>";

  page += "<div class='card'>🌀 Servo: <span style='color:" + servoColor + "'>" + servoStatus + "</span></div>";

  page += "<div class='card'>💡 LED/Tira LED: <span class='status'>" + ledStatus + "</span></div>";

  page += R"rawliteral(

</div>
</body>
</html>
)rawliteral";

  server.send(200, "text/html", page);
}

void setup() {

  Serial.begin(115200);

  pinMode(LED, OUTPUT);
  pinMode(STRIP, OUTPUT);
  pinMode(BUTTON, INPUT_PULLUP);

  servo.attach(SERVO_PIN);
  servo.write(90);

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
  }

  Serial.println("WiFi CONNECTAT");
  Serial.print("IP WEB: ");
  Serial.println(WiFi.localIP());

  server.on("/", handleRoot);

  server.begin();
}

void loop() {

  server.handleClient();

  // 🔘 BOTÓ AUTO / MANUAL
  if (digitalRead(BUTTON) == LOW &&
      millis() - lastButtonPress > 400) {

    autoMode = !autoMode;

    lastButtonPress = millis();
  }

  // 📊 LECTURA SENSORS
  tempC = (analogRead(LM35) * 3.3 / 4095.0) * 100;

  lightValue = analogRead(LIGHT);

  // 💡 LEDS LLUM
  digitalWrite(LED, lightValue < 1500);

  digitalWrite(STRIP, lightValue < 1500);

  // 🧠 LÒGICA SERVO
  bool servoActive;

  // 🤖 AUTO
  if (autoMode) {

    servoActive =
      (tempC > 13.5 && lightValue < 1500);

  }

  // ✋ MANUAL
  else {

    servoActive =
      (tempC > 13.5);
  }

  // 🌀 MOVIMENT SERVO
  if (servoActive) {

    angle += stepDir;

    if (angle >= 180 || angle <= 0) {
      stepDir = -stepDir;
    }

    servo.write(angle);

    delay(15);

  }

  else {

    servo.write(90);
  }
}
