#include <WiFi.h>
#include <WebServer.h>

#define LM35 34
#define LIGHT 35
#define LED 27

const char* ssid = "ProjectesSMX";
const char* password = "SI123456";

WebServer server(80);

float tempC;
int lightValue;

void handleRoot() {

  String page =
  "<html><body style='font-family:Arial;'>"
  "<h1 style='font-size:32px;'>Escola Intel·ligent</h1>"
  "<h2 style='font-size:20px; color:black;'>Dades ambientals</h2>"
  "<p style='font-size:16px;'>Temperatura: " + String(tempC) + " ºC</p>"
  "<p style='font-size:16px;'>Llum: " + String(lightValue) + "</p>"
  "</body></html>";

  server.send(200, "text/html", page);
}

void setup() {
  Serial.begin(115200);

  pinMode(LED, OUTPUT);

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) delay(500);

  server.on("/", handleRoot);
  server.begin();
}

void loop() {
  tempC = (analogRead(LM35) * 3.3 / 4095.0) * 100;
  lightValue = analogRead(LIGHT);

  digitalWrite(LED, lightValue < 1500);

  server.handleClient();
}
