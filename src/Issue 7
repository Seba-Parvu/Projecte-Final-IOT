#include <WiFi.h>
#include <WebServer.h>

#define LM35 34
#define LIGHT 35
#define LED 27

const char* ssid = "ProjectesSMX";
const char* password = "SI123456";

WebServer server(80);

float tempC;
int lightValue;

void handleRoot() {

  String page =
  "<html><body>"
  "<h1>Escola Intel·ligent</h1>"
  "<p>Temperatura: " + String(tempC) + "</p>"
  "<p>Llum: " + String(lightValue) + "</p>"
  "</body></html>";

  server.send(200, "text/html", page);
}

void setup() {
  Serial.begin(115200);

  pinMode(LED, OUTPUT);

  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) delay(500);

  server.on("/", handleRoot);
  server.begin();
}

void loop() {
  tempC = (analogRead(LM35)*3.3/4095.0)*100;
  lightValue = analogRead(LIGHT);

  // 💡 REGLE
  digitalWrite(LED, lightValue < 1500);

  server.handleClient();
}
