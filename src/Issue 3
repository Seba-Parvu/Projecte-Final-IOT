#include <WiFi.h>
#include <WebServer.h>

const char* ssid = "ProjectesSMX";
const char* password = "SI123456";

WebServer server(80);

void handleRoot() {

  String page = "<html><body>";

  page += "<h1>Escola Intel·ligent</h1>";
  page += "<h2>Dades Ambientals</h2>";

  page += "<p>Temperatura: --</p>";
  page += "<p>Llum: --</p>";

  page += "</body></html>";

  server.send(200, "text/html", page);
}

void setup() {

  Serial.begin(115200);

  Serial.println("Iniciant ESP32...");

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
  }

  Serial.println("WiFi CONNECTAT!");
  Serial.println(WiFi.localIP());

  server.on("/", handleRoot);

  server.begin();
}

void loop() {
  server.handleClient();
}
